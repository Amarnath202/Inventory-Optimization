# =============================================================================
#  FinalProject — .gitignore
#  Inventory Optimization & Excess Stock Management System
# =============================================================================

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# Virtual environments — single root-level .venv only
.venv/
venv/
env/
ENV/
.env.bak
# Old per-module venvs (superseded by root .venv)
module1_data_management/.venv/
module2_demand_forecasting/.venv/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/

# pytest / testing artefacts
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.coveragerc
nosetests.xml
junit*.xml

# mypy / type-checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ─── Secrets / Environment ────────────────────────────────────────────────────
.env
.env.*
!.env.example
!**/.env.example

# ─── Local databases / data exports ──────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db3
*.dump
*.sql.gz

# ─── Datasets (large binary / generated) ────────────────────────────────────
Dataset/
# If you ever add datasets inside modules:
module1_data_management/data/raw/
module1_data_management/data/processed/

# ─── Trained Models (binary artefacts — large) ───────────────────────────────
module2_demand_forecasting/models/*.joblib
module2_demand_forecasting/models/cv_models/
module2_demand_forecasting/models/latest_model_version.txt
module2_demand_forecasting/models/model_metadata.json
*.joblib
*.pkl
*.pickle
*.npy
*.npz
*.h5
*.hdf5

# ─── Generated Reports / Audit / Research files ──────────────────────────────
# Research audit artefacts (prediction CSVs, intermediate metrics, etc.)
module2_demand_forecasting/reports/research_audit/

# Large per-product metric CSVs (regenerated by training)
module2_demand_forecasting/reports/per_product_metrics_*.csv

# Module 1 audit scripts and results (ad-hoc, not part of the app)
module1_data_management/audit_checks.py
module1_data_management/audit_counts.py
module1_data_management/audit_results.txt
module1_data_management/current_schema.sql

# Root-level one-off audit / research scripts
recompute_all_metrics.py
evaluate_fair_protocols.py

# Root-level verification markdown files (generated, not source)
module2_final_test_population_verification.md
module2_two_issue_verification.md
research.md

# ─── Log files ───────────────────────────────────────────────────────────────
*.log
logs/
module2_demand_forecasting/logs/

# ─── Node / Frontend ─────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/.vite/
*.local

# ─── OS / Editor artefacts ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Miscellaneous ───────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
