# ── Module 1 – Environment Variables Template ─────────────────────────────────
# Copy this file to the FinalProject root as .env and fill in your values.
# NEVER commit the real .env file to source control.

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_optimization_db2
DB_USER=postgres
DB_PASSWORD=your_password_here

# Full DSN (optional – constructed automatically if not set)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/inventory_optimization_db2
