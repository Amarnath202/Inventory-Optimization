# Module 2 — Environment Variables
# Copy this file to the project root FinalProject/.env and fill in credentials.
# The root .env is shared with Module 1.

# PostgreSQL (already set by Module 1)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/inventory_optimization_db2
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_optimization_db2
DB_USER=postgres
DB_PASSWORD=your_password_here

# Module 2 — API
M2_API_HOST=0.0.0.0
M2_API_PORT=8000

# Module 2 — Scheduler
M2_SCHEDULER_TIMEZONE=Asia/Kolkata
M2_SCHEDULER_DAY_OF_WEEK=sun
M2_SCHEDULER_HOUR=2
M2_SCHEDULER_MINUTE=0
M2_ADVISORY_LOCK_KEY=20261001
M2_INTERRUPTED_RUN_THRESHOLD_HOURS=6

# Module 2 — Model
M2_MIN_HISTORY_DAYS=28
M2_FORECAST_HORIZON=7
